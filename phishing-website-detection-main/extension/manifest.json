{
  "manifest_version": 3,
  "name": "PhishGuard AI — Web Protection Shield",
  "version": "1.0.0",
  "description": "Real-time navigation guard against phishing websites, credential harvesters, and malicious redirects.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishGuard AI Protection"
  },
  "icons": {
    "48": "icon48.png"
  }
}
